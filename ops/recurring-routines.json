{
  "version": "2.4",
  "site": "OutsourceAccountsPayable.com",
  "repository": "coolifystealthagents/outsourceaccountspayable",
  "branch": "main",
  "timezone": "UTC",
  "secretInjection": ["github", "gemini"],
  "terminalState": "verified_github_push",
  "coolifyDeploymentInRoutine": false,
  "googleSearchConsoleInRoutine": false,
  "routines": [
    {
      "id": "daily-blog-publishing",
      "title": "Daily Blog Publishing",
      "cron": "0 9 * * 1-5",
      "concurrency": "skip_if_active",
      "catchUp": "skip_missed",
      "priority": "medium",
      "randomTarget": { "minimum": 20, "maximum": 25 },
      "workflow": [
        "select_and_record_random_target",
        "topic_duplicate_canonical_and_intent_check",
        "brief_research_and_single_authoritative_external_source",
        "draft_existing_blog_data_model",
        "standard_blog_validation",
        "blader_humanizer_2_9_1_or_later",
        "post_humanizer_validation",
        "deterministic_thumbnail_generation_and_validation",
        "update_indexes_and_sitemap_inputs",
        "build_and_structured_data_validation",
        "fetch_rebase_stage_intended_files_commit_push",
        "record_sha_branch_files_push_and_validation"
      ],
      "humanizer": {
        "source": "https://github.com/blader/humanizer",
        "minimumVersion": "2.9.1",
        "required": true
      },
      "push": { "repository": "coolifystealthagents/outsourceaccountspayable", "branch": "main" },
      "afterPush": "stop"
    },
    {
      "id": "daily-research-publishing",
      "title": "Daily Research Publishing",
      "cron": "0 6 * * *",
      "concurrency": "always_enqueue",
      "catchUp": "skip_missed",
      "priority": "high",
      "randomTarget": { "minimum": 10, "maximum": 15 },
      "workflow": [
        "select_and_record_random_target",
        "cluster_topic_duplicate_canonical_and_intent_check",
        "headline_statistic_and_minimum_10_real_sources",
        "brief_research_and_restrained_evidence_first_draft",
        "research_validation",
        "blader_humanizer_2_9_1_or_later",
        "post_humanizer_validation",
        "deterministic_thumbnail_generation_and_validation",
        "update_indexes_clusters_related_content_and_sitemap_inputs",
        "build_and_structured_data_validation",
        "fetch_rebase_stage_intended_files_commit_push",
        "record_sha_branch_files_push_and_validation"
      ],
      "humanizer": {
        "source": "https://github.com/blader/humanizer",
        "minimumVersion": "2.9.1",
        "required": true
      },
      "push": { "repository": "coolifystealthagents/outsourceaccountspayable", "branch": "main" },
      "afterPush": "stop"
    },
    {
      "id": "batched-coolify-deployment",
      "title": "Batched Coolify Deployment",
      "cron": "0 3,9,15,21 * * *",
      "timezone": "UTC",
      "concurrency": "skip_if_active",
      "catchUp": "skip_missed",
      "priority": "high",
      "project": "Onboarding",
      "assignee": "Chief of staff",
      "workflow": [
        "verify_exact_domain_repository_branch_application_mapping",
        "require_all_daily_blog_items_complete_validated_and_build_verified",
        "reconcile_persisted_batch_sha_and_deployment_before_mutation",
        "create_one_validated_combined_blog_commit_and_one_production_push",
        "confirm_sha_has_no_queued_active_or_successful_deployment",
        "inspect_global_coolify_queue_once",
        "emit_SKIPPED_COOLIFY_QUEUE_at_three_or_more_without_submission_or_polling",
        "trigger_exactly_one_manual_deployment_below_queue_cap",
        "persist_non_secret_batch_and_deployment_evidence",
        "reconcile_until_success_then_verify_exact_commit_and_new_blog_pages_live",
        "finish_with_exactly_one_allowed_outcome"
      ],
      "protectedConfiguration": [
        "COOLIFY_API_URL",
        "COOLIFY_API_TOKEN",
        "COOLIFY_APPLICATION_UUID"
      ],
      "allowedOutcomes": [
        "SKIPPED_INCOMPLETE",
        "NO_NEW_CHANGES",
        "ALREADY_DEPLOYED",
        "DEPLOYMENT_ALREADY_PENDING",
        "SKIPPED_COOLIFY_QUEUE",
        "DEPLOYMENT_SUBMITTED",
        "DEPLOYMENT_IN_PROGRESS",
        "DEPLOYMENT_FAILED",
        "LIVE_VERIFIED"
      ]
    }
  ]
}
